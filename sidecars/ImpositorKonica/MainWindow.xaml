<Window x:Class="ImpositorKonica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ImpositorKonica.Views"
        Title="Impositor Konica SRA3 - GraficaOS Native Pre-press"
        Height="850" Width="1360"
        MinHeight="600" MinWidth="900"
        WindowState="Maximized"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Toolbar -->
            <RowDefinition Height="*" />    <!-- Work Area -->
            <RowDefinition Height="30" />   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP TOOLBAR (ESTILO KODAK PREPS) -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <!-- Identificação e Status da Folha -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="MESA DE IMPOSIÇÃO SRA3" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <Border Background="#18181B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtSheetMetrics" Text="Folha: 330 x 480 mm | Área Útil: 320 x 470 mm" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Ações Principais (Dock Right) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Zoom Tools -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Button Content="−" Width="28" ToolTip="Reduzir Zoom (Ctrl + Wheel Down)" Click="OnZoomOutClick" Margin="0,0,2,0" />
                        <Button Content="+" Width="28" ToolTip="Aumentar Zoom (Ctrl + Wheel Up)" Click="OnZoomInClick" Margin="0,0,2,0" />
                        <Button Content="100%" Width="44" ToolTip="Zoom 1:1" Click="OnZoom100Click" Margin="0,0,2,0" />
                        <Button Content="Enquadrar (F4)" Width="95" ToolTip="Zoom Extents - Enquadrar Folha (F4)" Click="OnZoomExtentsClick" />
                    </StackPanel>

                    <!-- Alternar Orientação -->
                    <Button x:Name="BtnOrientation" Content="Vertical (8x5 = 40 un)" Click="OnToggleOrientationClick" Margin="0,0,8,0" />

                    <!-- AutoGang -->
                    <Button Content="⚡ AutoGang" Background="#D97706" BorderBrush="#B45309" Click="OnAutoGangClick" Margin="0,0,8,0" ToolTip="Preenche todos os slots vazios da chapa com os itens da lista" />

                    <!-- Alinhamentos Rápidos -->
                    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1,0,0,0" Margin="4,0,8,0" Padding="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="P" Width="26" ToolTip="Centralizar seleção na folha (P)" Click="OnCenterSheetClick" Margin="0,0,2,0" />
                            <Button Content="C" Width="26" ToolTip="Alinhar centros horizontais (C)" Click="OnAlignCentersHClick" Margin="0,0,2,0" />
                            <Button Content="E" Width="26" ToolTip="Alinhar centros verticais (E)" Click="OnAlignCentersVClick" Margin="0,0,2,0" />
                            <Button Content="T" Width="26" ToolTip="Alinhar ao topo da margem (T)" Click="OnAlignTopClick" Margin="0,0,2,0" />
                            <Button Content="B" Width="26" ToolTip="Alinhar à base da margem (B)" Click="OnAlignBottomClick" Margin="0,0,2,0" />
                            <Button Content="L" Width="26" ToolTip="Alinhar à esquerda (L)" Click="OnAlignLeftClick" Margin="0,0,2,0" />
                            <Button Content="R" Width="26" ToolTip="Alinhar à direita (R)" Click="OnAlignRightClick" Margin="0,0,6,0" />
                        </StackPanel>
                    </Border>

                    <!-- Limpar Chapa -->
                    <Button Content="Limpar" Foreground="#EF4444" Click="OnClearSheetClick" Margin="0,0,12,0" />

                    <!-- Disparo para Konica -->
                    <Button Content="🖨️ Enviar para Konica" Background="#059669" BorderBrush="#047857" Foreground="White" FontSize="13" FontWeight="Bold" Padding="14,6" Click="OnPrintToKonicaClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. MAIN WORK AREA (2 COLUNAS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" /> <!-- Sidebar Insumos -->
                <ColumnDefinition Width="*" />   <!-- Canvas 2D DirectX -->
            </Grid.ColumnDefinitions>

            <!-- LATERAL ESQUERDA: LISTA DE ETIQUETAS/INSUMOS -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Busca -->
                        <RowDefinition Height="*" />    <!-- Lista de Itens -->
                    </Grid.RowDefinitions>

                    <!-- Campo de Busca -->
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                        <TextBox x:Name="TxtSearch" Height="30" Background="#18181B" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderDarkBrush}" Padding="8,4" FontSize="12"
                                 TextChanged="OnSearchTextChanged" />
                    </Border>

                    <!-- Lista de Insumos Prontos para Imposição -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl x:Name="ItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#18181B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                                                    <Border Background="#27272A" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Botão Adicionar ao Próximo Slot -->
                                            <Button Grid.Column="1" Content="+" Width="32" Height="32" FontSize="14"
                                                    Click="OnAddItemClick" Tag="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Inserir na folha" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTRO: CANVAS NATIVO DIRECTX COM RENDERING 60 FPS -->
            <Grid Grid.Column="1" Background="#18181B">
                <views:CanvasImposicao x:Name="CanvasImpositor" />
            </Grid>
        </Grid>

        <!-- 3. STATUS BAR INDUSTRIAL -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtOccupancyStatus" Text="Ocupação: 0 de 40 posições (0%)" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Atalhos: F4 (Enquadrar) | P (Centralizar) | C/E (Alinhar Centros) | T/B/L/R (Bordas) | Ctrl+D (Duplicar) | Del (Remover) | Esc (Sair)"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <TextBlock />
            </DockPanel>
        </Border>
    </Grid>
</Window>
