<Window x:Class="ImpositorKonica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ImpositorKonica.Views"
        Title="Impositor Konica SRA3 - GraficaOS"
        Height="850" Width="1360"
        MinHeight="600" MinWidth="900"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#222222"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Separador de Menus -->
        <Style TargetType="{x:Type Separator}" x:Key="IllustratorMenuSeparator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,3,4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border BorderBrush="#3A3A3A" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos de Controles de Janela -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos da Control Bar (Estilo Adobe Illustrator) -->
        <Style x:Key="CbButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A4A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#222222" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CbIconButton" TargetType="Button" BasedOn="{StaticResource CbButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A4A" />
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#222222" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CbToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A4A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#4A4A4A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CbSend" TargetType="Button" BasedOn="{StaticResource CbButton}">
            <Setter Property="Background" Value="#107C41" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F6D39" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0C572D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CbSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="#444444" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        
        </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />   <!-- Nível 1: Menu Bar -->
            <RowDefinition Height="34" />   <!-- Nível 2: Control Bar -->
            <RowDefinition Height="*" />    <!-- Nível 3: Work Area -->
            <RowDefinition Height="30" />   <!-- Nível 4: Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. NÍVEL 1: MENU BAR E CONTROLES DE JANELA (32px, #262626) -->
        <Grid Grid.Row="0" Background="#262626">
            <!-- Área de arrasto central com título -->
            <TextBlock Text="Impositor Konica SRA3 — GraficaOS" 
                       Foreground="#777777" FontSize="11" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       WindowChrome.IsHitTestVisibleInChrome="False" />

            <!-- Lado Esquerdo: Branding + Menus -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Ícone do App -->
                <Path Data="M 4,4 L 14,4 L 14,14 L 4,14 Z M 6,6 L 12,6 L 12,12 L 6,12 Z" Fill="#D97706" Width="18" Height="18" Margin="8,0,4,0" VerticalAlignment="Center" />
                
                <Border Width="1" Background="#3E3E3E" Height="14" Margin="6,0" VerticalAlignment="Center" />

                <!-- Menus Clássicos -->
                <Menu Background="Transparent" VerticalAlignment="Center" Margin="2,0,0,0" TextElement.Foreground="#E0E0E0">
                    <Menu.Resources>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#D4D4D4"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontFamily" Value="Segoe UI, -apple-system, sans-serif"/>
                            <Setter Property="Padding" Value="7,4,7,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type MenuItem}">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True" x:Name="TemplateRoot">
                                            <Grid>
                                                <!-- Top-level Header (Arquivo, Editar...) -->
                                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" x:Name="ContentPresenter"/>

                                                <!-- Popup do Submenu (Dropdown escuro) -->
                                                <Popup AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade" x:Name="PART_Popup">
                                                    <Border Background="#222222" BorderBrush="#3D3D3D" BorderThickness="1" Padding="2,3" x:Name="SubMenuBorder">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" TargetName="TemplateRoot" Value="#383838"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSubmenuOpen" Value="True">
                                                <Setter Property="Background" TargetName="TemplateRoot" Value="#2A2A2A"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Menu.Resources>
                    <MenuItem Header="Arquivo">
                        <MenuItem Header="Configurar Folha..." InputGestureText="Ctrl+N" Click="OnMenuConfigSheetClick" />
                        <MenuItem Header="Salvar PDF SRA3..." InputGestureText="Ctrl+S" Click="OnMenuSavePdfClick" />
                        <Separator />
                        <MenuItem Header="Fechar Janela" InputGestureText="Alt+F4" Click="OnMenuCloseClick" />
                    </MenuItem>
                    <MenuItem Header="Editar">
                        <MenuItem Header="Desfazer" InputGestureText="Ctrl+Z" Click="OnMenuUndoClick" />
                        <MenuItem Header="Refazer" InputGestureText="Ctrl+Y" Click="OnMenuRedoClick" />
                        <Separator />
                        <MenuItem Header="Limpar Folha" Click="OnMenuClearSheetClick" />
                    </MenuItem>
                    <MenuItem Header="Objeto">
                        <MenuItem Header="Agrupar" InputGestureText="Ctrl+G" Click="OnGroupClick" />
                        <MenuItem Header="Desagrupar" InputGestureText="Ctrl+Shift+G" Click="OnUngroupClick" />
                        <MenuItem Header="Girar 90°" InputGestureText="R" Click="OnMenuRotateClick" />
                        <Separator />
                        <MenuItem Header="Alinhar">
                            <MenuItem Header="Esquerda" Click="OnAlignLeftClick" />
                            <MenuItem Header="Centro Horizontal" Click="OnAlignCentersHClick" />
                            <MenuItem Header="Direita" Click="OnAlignRightClick" />
                            <MenuItem Header="Topo" Click="OnAlignTopClick" />
                            <MenuItem Header="Centro Vertical" Click="OnAlignCentersVClick" />
                            <MenuItem Header="Base" Click="OnAlignBottomClick" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Selecionar">
                        <MenuItem Header="Tudo" InputGestureText="Ctrl+A" Click="OnMenuSelectAllClick" />
                        <MenuItem Header="Desmarcar Tudo" InputGestureText="Esc" Click="OnMenuDeselectAllClick" />
                        <MenuItem Header="Inverter Seleção" Click="OnMenuInvertSelectionClick" />
                    </MenuItem>
                    <MenuItem Header="Exibir">
                        <MenuItem Header="Enquadrar Folha na Janela" InputGestureText="F4" Click="OnZoomExtentsClick" />
                        <MenuItem Header="Tamanho Real (100%)" InputGestureText="Ctrl+1" Click="OnZoom100Click" />
                        <MenuItem Header="Aumentar Zoom" InputGestureText="Ctrl++" Click="OnZoomInClick" />
                        <MenuItem Header="Diminuir Zoom" InputGestureText="Ctrl+-" Click="OnZoomOutClick" />
                        <Separator />
                        <MenuItem Header="Marcas de Corte" IsCheckable="True" IsChecked="{Binding IsChecked, ElementName=BtnCropMarks}" Click="OnMenuToggleCropMarks" />
                    </MenuItem>
                    <MenuItem Header="Ajuda">
                        <MenuItem Header="Atalhos do Operador" Click="OnMenuShortcutsClick" />
                        <MenuItem Header="Sobre o GraficaOS" Click="OnMenuAboutClick" />
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!-- Lado Direito: Controles do Windows -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="46" Style="{StaticResource WindowControlBtn}" Click="OnMinClick" ToolTip="Minimizar" />
                <Button Content="□" Width="46" Style="{StaticResource WindowControlBtn}" Click="OnMaxClick" ToolTip="Maximizar/Restaurar" />
                <Button Content="✕" Width="46" Style="{StaticResource WindowCloseBtn}" Click="OnCloseClick" ToolTip="Fechar" />
            </StackPanel>
        </Grid>

        <!-- 2. NÍVEL 2: CONTROL BAR ESTILO ADOBE ILLUSTRATOR (34px, #333333) -->
        <Border Grid.Row="1" Background="#333333" BorderBrush="#222222" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="8,0">
                <!-- GRUPO ESQUERDO: Alinhamentos + Coordenadas + Pré-Impressão -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Ícones Vetoriais de Alinhamento (16x16 px style compact) -->
                    <Button Style="{StaticResource CbIconButton}" ToolTip="Alinhar à Esquerda (L)" Click="OnAlignLeftClick">
                        <Path Data="M 2,2 L 2,14 M 2,4 L 10,4 L 10,7 L 2,7 M 2,9 L 14,9 L 14,12 L 2,12" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource CbIconButton}" ToolTip="Alinhar Centros Horizontais (C)" Click="OnAlignCentersHClick">
                        <Path Data="M 8,2 L 8,14 M 4,4 L 12,4 L 12,7 L 4,7 M 2,9 L 14,9 L 14,12 L 2,12" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource CbIconButton}" ToolTip="Alinhar à Direita (R)" Click="OnAlignRightClick">
                        <Path Data="M 14,2 L 14,14 M 6,4 L 14,4 L 14,7 L 6,7 M 2,9 L 14,9 L 14,12 L 2,12" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource CbIconButton}" ToolTip="Alinhar ao Topo (T)" Click="OnAlignTopClick">
                        <Path Data="M 2,2 L 14,2 M 4,2 L 4,10 L 7,10 L 7,2 M 9,2 L 9,14 L 12,14 L 12,2" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource CbIconButton}" ToolTip="Alinhar Centros Verticais (E)" Click="OnAlignCentersVClick">
                        <Path Data="M 2,8 L 14,8 M 4,4 L 4,12 L 7,12 L 7,4 M 9,2 L 9,14 L 12,14 L 12,2" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource CbIconButton}" ToolTip="Alinhar à Base (B)" Click="OnAlignBottomClick">
                        <Path Data="M 2,14 L 14,14 M 4,6 L 4,14 L 7,14 L 7,6 M 9,2 L 9,14 L 12,14 L 12,2" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource CbIconButton}" ToolTip="Centralizar na Chapa (P)" Click="OnCenterSheetClick">
                        <Path Data="M 1,8 L 6,8 M 10,8 L 15,8 M 8,1 L 8,6 M 8,10 L 8,15 M 5,5.5 L 11,5.5 L 11,10.5 L 5,10.5 Z" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="Uniform" Width="14" Height="14" />
                    </Button>

                    <Border Style="{StaticResource CbSeparator}" />

                    <!-- Coordenadas Numéricas (Inputs Escuros) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="X:" Foreground="#8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="2" Padding="4,0" Height="22" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCoordX" Text="0,00 mm" Foreground="#FFFFFF" FontSize="11" MinWidth="42" TextAlignment="Right" VerticalAlignment="Center" />
                        </Border>
                        
                        <TextBlock Text="Y:" Foreground="#8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="2" Padding="4,0" Height="22" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCoordY" Text="0,00 mm" Foreground="#FFFFFF" FontSize="11" MinWidth="42" TextAlignment="Right" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="L:" Foreground="#8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="2" Padding="4,0" Height="22" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCoordL" Text="0,00 mm" Foreground="#FFFFFF" FontSize="11" MinWidth="42" TextAlignment="Right" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="A:" Foreground="#8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="2" Padding="4,0" Height="22" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCoordA" Text="0,00 mm" Foreground="#FFFFFF" FontSize="11" MinWidth="42" TextAlignment="Right" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource CbSeparator}" />

                    <!-- Controles de Ferramentas / Agrupamento -->
                    <Button Style="{StaticResource CbButton}" Content="Agrupar" Click="OnGroupClick" ToolTip="Agrupar (Ctrl+G)" Margin="0,0,2,0" />
                    <Button Style="{StaticResource CbButton}" Content="Desagrupar" Click="OnUngroupClick" ToolTip="Desagrupar (Ctrl+Shift+G)" Margin="0,0,2,0" />
                    
                    <Border Style="{StaticResource CbSeparator}" />
                    
                    <ToggleButton x:Name="BtnCropMarks" Style="{StaticResource CbToggle}" IsChecked="True" Content="✂ Marcas" Click="OnToggleCropMarks" ToolTip="Marcas de Corte" Margin="0,0,2,0" />
                    <ToggleButton x:Name="BtnAutoGang" Style="{StaticResource CbToggle}" Content="⚙ AutoGang" Click="OnToggleAutoGang" ToolTip="Preencher folha automaticamente" Margin="0,0,2,0" />
                </StackPanel>

                <!-- GRUPO DIREITO: Zoom + Orientação + Disparo -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnOrientation" Style="{StaticResource CbButton}" Content="330×480 mm | 8×5 (40 un) ▾" Click="OnToggleOrientationClick" ToolTip="Alternar orientação" Margin="0,0,4,0" />

                    <Border Style="{StaticResource CbSeparator}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                        <Button Style="{StaticResource CbButton}" Content="−" Width="22" Padding="0" ToolTip="Reduzir Zoom" Click="OnZoomOutClick" Margin="0,0,2,0" />
                        <Button Style="{StaticResource CbButton}" Content="100%" Width="42" Padding="0" ToolTip="Zoom 1:1" Click="OnZoom100Click" Margin="0,0,2,0" />
                        <Button Style="{StaticResource CbButton}" Content="+" Width="22" Padding="0" ToolTip="Aumentar Zoom" Click="OnZoomInClick" Margin="0,0,2,0" />
                        <Button Style="{StaticResource CbButton}" Content="Enquadrar" Padding="6,0" ToolTip="Enquadrar Folha (F4)" Click="OnZoomExtentsClick" />
                    </StackPanel>

                    <Border Style="{StaticResource CbSeparator}" />

                    <Button Style="{StaticResource CbSend}" Click="OnMenuSavePdfClick" ToolTip="Exporta o PDF (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 3,1 L 11,1 L 11,5 L 3,5 Z M 12,2 L 13,2 L 13,14 L 3,14 L 3,12 M 5,7 L 11,7 L 11,14 L 5,14 Z M 5,12 L 11,12"
                                  Stroke="White" StrokeThickness="1.2" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Width="12" Height="12" />
                            <TextBlock Text="Salvar PDF" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. MAIN WORK AREA (2 COLUNAS) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" /> <!-- Sidebar Insumos -->
                <ColumnDefinition Width="*" />   <!-- Canvas 2D DirectX -->
            </Grid.ColumnDefinitions>

            <!-- LATERAL ESQUERDA: LISTA DE ETIQUETAS/INSUMOS -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Busca -->
                        <RowDefinition Height="*" />    <!-- Lista de Itens -->
                    </Grid.RowDefinitions>

                    <!-- Campo de Busca -->
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                        <TextBox x:Name="TxtSearch" Height="30" Background="#18181B" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderDarkBrush}" Padding="8,4" FontSize="12"
                                 TextChanged="OnSearchTextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <Label Content="Buscar código (#1042) ou nome..." Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Lista de Insumos Prontos para Imposição -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl x:Name="ItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#18181B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                                                    <Border Background="#27272A" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Botão Adicionar ao Próximo Slot -->
                                            <Button Grid.Column="1" Content="+" Width="32" Height="32" FontSize="14"
                                                    Click="OnAddItemClick" Tag="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Inserir na folha" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTRO: CANVAS NATIVO DIRECTX COM RENDERING 60 FPS -->
            <Grid Grid.Column="1" Background="#18181B">
                <views:CanvasImposicao x:Name="CanvasImpositor" />
            </Grid>
        </Grid>

        <!-- 4. STATUS BAR INDUSTRIAL SUTIL (#262626) -->
        <Border Grid.Row="3" Background="#262626" BorderBrush="#1C1C1C" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtOccupancyStatus" Text="Ocupação: 0 de 40 posições (0%)" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />

                <TextBlock x:Name="TxtSheetMetrics" Text="Folha: 330 x 480 mm | Área Útil: 320 x 470 mm" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="24,0,0,0" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Pronto." FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <TextBlock />
            </DockPanel>
        </Border>
    </Grid>
</Window>