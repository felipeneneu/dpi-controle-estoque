<Window x:Class="ImpositorKonica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ImpositorKonica.ViewModels"
        mc:Ignorable="d"
        Title="Editor de pré-impressão" Height="768" Width="1024"
        Background="#F0EFEA" FontFamily="Segoe UI" FontSize="11"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#F0EFEA" />
        <SolidColorBrush x:Key="BgSecondary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgPanel" Color="#F5F5F5" />
        <SolidColorBrush x:Key="BorderColor" Color="#C8C8C8" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1E1E1E" />
        <SolidColorBrush x:Key="TextSecondary" Color="#5A5A5A" />
        <SolidColorBrush x:Key="AccentColor" Color="#4A8DB7" />
        <SolidColorBrush x:Key="CanvasBege" Color="#F5F1D6" />

        <Style TargetType="Expander">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource BgSecondary}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BgPanel}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="Button" x:Key="CrudButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ZoomExtentsCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="V" Command="{Binding SelectToolCommand}" />
        <KeyBinding Key="T" Command="{Binding TextToolCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!-- (1) PAINEL ESQUERDO: Produtos, Arquivos, Recursos -->
        <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Background="{StaticResource BgSecondary}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Expander Header="Produtos">
                        <TreeView ItemsSource="{Binding ProdutosVM.Produtos}" BorderThickness="0" Height="150" Background="{StaticResource BgSecondary}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding SubProdutos}">
                                    <TextBlock Text="{Binding Nome}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Expander>

                    <Expander Header="Arquivos">
                        <DataGrid ItemsSource="{Binding ArquivosVM.Arquivos}" SelectedItem="{Binding ArquivosVM.ArquivoSelecionado}" Height="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome do arquivo" Binding="{Binding NomeArquivo}" Width="*" />
                                <DataGridTextColumn Header="Páginas" Binding="{Binding ContagemPaginas}" Width="60" />
                                <DataGridTextColumn Header="Arremate" Binding="{Binding Arremate}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>

                    <Expander Header="Recursos">
                        <TabControl Background="{StaticResource BgSecondary}" BorderThickness="0">
                            <TabItem Header="Mídia">
                                <DataGrid ItemsSource="{Binding RecursosVM.Recursos}" SelectedItem="{Binding RecursosVM.RecursoSelecionado}" Height="150">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                                        <DataGridTextColumn Header="Dimensões" Binding="{Binding Dimensoes}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Bloco" />
                            <TabItem Header="Marcas" />
                            <TabItem Header="Layouts" />
                            <TabItem Header="AutoGang" />
                        </TabControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- (2) CENTRO: TabControl, ToolBar e Canvas -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <TabControl Grid.Row="0" Background="{StaticResource BgSecondary}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderColor}">
                <TabItem Header="Páginas" />
                <TabItem Header="Conjunto" />
                <TabItem Header="Execuções de impressão" IsSelected="True" Background="{StaticResource AccentColor}" Foreground="Black" />
            </TabControl>

            <ToolBar Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                <Button Content="[V]" ToolTip="Seleção (V)" Command="{Binding SelectToolCommand}" />
                <Button Content="[T]" ToolTip="Texto (T)" Command="{Binding TextToolCommand}" />
                <Separator />
                <Button Content="[+]" ToolTip="Zoom In (Ctrl++)" Command="{Binding ZoomInCommand}" />
                <Button Content="[-]" ToolTip="Zoom Out (Ctrl+-)" Command="{Binding ZoomOutCommand}" />
                <Button Content="[0]" ToolTip="Ajustar à tela (Ctrl+0)" Command="{Binding ZoomExtentsCommand}" />
                <Separator />
                <!-- Modos de visualização list/grid placeholer -->
                <Button Content="[List]" />
                <Button Content="[Grid]" />
            </ToolBar>

            <Border Grid.Row="2" Background="{StaticResource CanvasBege}" AllowDrop="True">
                <!-- Drop handler should ideally be attached via Behavior/EventToCommand -->
                <TextBlock Text="Arraste aqui a mídia, o material ou o modelo" 
                           Foreground="#A0A0A0" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- (3) PAINEL DIREITO: Propriedades -->
        <Border Grid.Row="0" Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,1" Background="{StaticResource BgPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,4">
                    <TextBlock Text="Propriedades" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding PropriedadesVM.ItemSelecionado}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="Nenhum item selecionado." Margin="10" Foreground="{StaticResource TextSecondary}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PropriedadesVM.ItemSelecionado}" Value="{x:Null}">
                                    <!-- Keep default template -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Border>

        <!-- (4) DATAGRID INFERIOR: Lista de Execuções -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource BgSecondary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Toolbar CRUD -->
            <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CrudButton}" Content="➕" Foreground="Green" Command="{Binding ExecucoesVM.AddCommand}" ToolTip="Adicionar" />
                    <Button Style="{StaticResource CrudButton}" Content="❌" Foreground="Red" Command="{Binding ExecucoesVM.RemoveCommand}" ToolTip="Remover" />
                    <Button Style="{StaticResource CrudButton}" Content="▲" Command="{Binding ExecucoesVM.MoveUpCommand}" ToolTip="Mover para cima" />
                    <Button Style="{StaticResource CrudButton}" Content="▼" Command="{Binding ExecucoesVM.MoveDownCommand}" ToolTip="Mover para baixo" />
                    <TextBlock Text="Lista de Execuções de impressão" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding ExecucoesVM.Execucoes}" SelectedItem="{Binding ExecucoesVM.ExecucaoSelecionada}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Execução de impressão" Binding="{Binding Nome}" Width="150" />
                    <DataGridTemplateColumn Header="Estilo de trabalho" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding EstiloTrabalho, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="Sheetwise" />
                                    <ComboBoxItem Content="Work and Turn" />
                                    <ComboBoxItem Content="Work and Tumble" />
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Seções" Binding="{Binding Secoes}" Width="60" />
                    <DataGridTextColumn Header="Etapa e repetições" Binding="{Binding EtapaERepeticoes}" Width="120" />
                    <DataGridTextColumn Header="Cores" Binding="{Binding Cores}" Width="60" />
                    <DataGridTextColumn Header="Bloco" Binding="{Binding Bloco}" Width="100" />
                    <DataGridTextColumn Header="Mídia" Binding="{Binding Midia}" Width="150" />
                    <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="150" />
                    <DataGridTextColumn Header="Assinatura" Binding="{Binding Assinatura}" Width="150" />
                    <DataGridTextColumn Header="Comprimento" Binding="{Binding Comprimento}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- (5) STATUS BAR -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ExecucoesVM.Status}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" 
                        Content="Gerar Execuções de impressão" 
                        Command="{Binding ExecucoesVM.GerarExecucoesCommand}" 
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>