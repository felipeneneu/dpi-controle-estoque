<Window x:Class="ImpositorKonica.Dialogs.ConfigurarFolhaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo documento"
        Width="920" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- ================= TOKENS ADOBE SPECTRUM DARK ================= -->
        <SolidColorBrush x:Key="AIBgLeft" Color="#262626" />
        <SolidColorBrush x:Key="AIBgRight" Color="#323232" />
        <SolidColorBrush x:Key="AIBorder" Color="#3E3E3E" />
        <SolidColorBrush x:Key="AICard" Color="#2B2B2B" />
        <SolidColorBrush x:Key="AICardSel" Color="#2F3542" />
        <SolidColorBrush x:Key="AIBlue" Color="#1473E6" />
        <SolidColorBrush x:Key="AIBlueHover" Color="#0D66D0" />
        <SolidColorBrush x:Key="AIText" Color="#E0E0E0" />
        <SolidColorBrush x:Key="AITextDim" Color="#9E9E9E" />
        <SolidColorBrush x:Key="AIInput" Color="#1E1E1E" />
        <SolidColorBrush x:Key="AIInputBorder" Color="#484848" />

        <!-- ================= RÓTULOS ================= -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#8E8E8E" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9E9E9E" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#9E9E9E" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- ================= INPUTS ================= -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource AIInput}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource AIInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A5A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AIBlue}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= COMBOBOX (DROP-DOWN ESCURO) ================= -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource AIInput}" />
            <Setter Property="BorderBrush" Value="{StaticResource AIInputBorder}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="3" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False" />
                            <Path x:Name="Arrow" Data="M 3,3 L 8,8 L 13,3" Stroke="#9E9E9E" StrokeThickness="1.4"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#156DE6" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0F4C9E" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= ABAS DE CATEGORIA ================= -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9E9E9E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="16,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="2" />
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0" VerticalAlignment="Center" />
                                <Border x:Name="Underline" Grid.Row="1" Background="#1473E6"
                                        CornerRadius="1" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2C" />
                                <Setter Property="Foreground" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#E0E0E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= CARD DE PREDEFINIÇÃO ================= -->
        <Style x:Key="PresetCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource AICard}"
                                BorderBrush="{StaticResource AIBorder}" BorderThickness="1"
                                CornerRadius="5" Padding="12,10" Margin="0,0,10,10" Height="92">
                            <StackPanel VerticalAlignment="Center">
                                <Path Data="M 4,1 L 13,1 L 17,5 L 17,19 L 4,19 Z M 13,1 L 13,5 L 17,5 M 7,9 L 15,9 M 7,12 L 15,12 M 7,15 L 12,15"
                                      Stroke="#C5C5C5" StrokeThickness="1.1" Width="26" Height="26"
                                      Stretch="Uniform" HorizontalAlignment="Left" />
                                <TextBlock x:Name="CardName" Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                           Foreground="#E0E0E0" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource AITextDim}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A5A" />
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1473E6" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Bd" Property="Background" Value="#2F3542" />
                                <Setter TargetName="CardName" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= TOGGLE DE ORIENTAÇÃO ================= -->
        <Style x:Key="OrientToggle" TargetType="RadioButton">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource AIInput}"
                                BorderBrush="{StaticResource AIInputBorder}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A5A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1473E6" />
                                <Setter TargetName="Bd" Property="Background" Value="#133057" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= BOTÕES ================= -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1473E6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D66D0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0B5BBB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderBrush" Value="#525252" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9E9E9E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= EXPANDER AVANÇADO ================= -->
        <Style x:Key="AdvExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Hd" Background="Transparent" Padding="0,8"
                                                BorderBrush="#3E3E3E" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                                  ContentSource="Content" />
                                                <Path Grid.Column="1" x:Name="Chevron"
                                                      Data="M 4,2 L 8,6 L 4,10" Stroke="#9E9E9E"
                                                      StrokeThickness="1.4" VerticalAlignment="Center"
                                                      Margin="0,0,2,2" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Data" Value="M 5,2 L 9,6 L 5,10" />
                                                <Setter TargetName="Chevron" Property="LayoutTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="OPÇÕES AVANÇADAS" FontSize="11" FontWeight="Bold"
                                           Foreground="#9E9E9E" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" ContentSource="Content" Visibility="Collapsed" Margin="0,8,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= TOGGLE CORRENTE (MARGENS SINCRONIZADAS) ================= -->
        <Style x:Key="LinkToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="6" Background="{StaticResource AIBgLeft}"
            BorderBrush="{StaticResource AIBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />   <!-- Título -->
                <RowDefinition Height="40" />   <!-- Abas -->
                <RowDefinition Height="*" />    <!-- Conteúdo -->
                <RowDefinition Height="64" />   <!-- Rodapé -->
            </Grid.RowDefinitions>

            <!-- ============ CABEÇALHO / BARRA DE TÍTULO ============ -->
            <Border Grid.Row="0" Background="{StaticResource AIBgLeft}"
                    BorderBrush="{StaticResource AIBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <TextBlock Text="Novo documento" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AIText}" Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource CloseButton}" Content="✕" Click="OnCloseClick"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                </Grid>
            </Border>

            <!-- ============ ABAS DE CATEGORIA ============ -->
            <Border Grid.Row="1" Background="{StaticResource AIBgLeft}"
                    BorderBrush="{StaticResource AIBorder}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabRadio}" Content="Recente" ToolTip="Documentos recentes (demonstração)" />
                    <RadioButton Style="{StaticResource TabRadio}" Content="Salvo" ToolTip="Predefinições salvas (demonstração)" />
                    <RadioButton Style="{StaticResource TabRadio}" Content="Impressão" IsChecked="True"
                                 ToolTip="Formatos de impressão de grafica" />
                    <RadioButton Style="{StaticResource TabRadio}" Content="Grandes Formatos" ToolTip="Lonas e grandes formatos" />
                    <RadioButton Style="{StaticResource TabRadio}" Content="Bobinas Mimaki/HP" ToolTip="Bobinas de impressora" />
                </StackPanel>
            </Border>

            <!-- ============ ÁREA PRINCIPAL ============ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="520" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- ESQUERDA: GRID DE PREDEFINIÇÕES DO DOCUMENTO EM BRANCO -->
                <Border Grid.Column="0" Background="{StaticResource AIBgLeft}" Padding="18,14,8,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}"
                                   Text="PREDEFINIÇÕES DO DOCUMENTO EM BRANCO" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PresetsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource PresetCard}"
                                                     GroupName="Presets"
                                                     Tag="{Binding}"
                                                     Checked="OnPresetChecked" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- DIREITA: PAINEL DE DETALHES DA PREDEFINIÇÃO -->
                <Border Grid.Column="1" Background="{StaticResource AIBgRight}"
                        BorderBrush="{StaticResource AIBorder}" BorderThickness="1,0,0,0" Padding="16,14,16,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <TextBlock Style="{StaticResource SectionLabel}"
                                       Text="DETALHES DA PREDEFINIÇÃO" Margin="0,0,0,6" />

                            <!-- Nome do Job -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="NOME DO JOB" />
                            <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"
                                     Text="Imposicao_Konica_01" />

                            <!-- Dimensões -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="DIMENSÕES" Margin="0,12,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LARGURA" />
                                    <TextBox x:Name="TxtWidth" Style="{StaticResource DarkTextBox}"
                                             TextChanged="OnDimensionChanged"
                                             PreviewTextInput="OnNumberPreviewInput" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="ALTURA" />
                                    <TextBox x:Name="TxtHeight" Style="{StaticResource DarkTextBox}"
                                             TextChanged="OnDimensionChanged"
                                             PreviewTextInput="OnNumberPreviewInput" />
                                </StackPanel>
                            </Grid>

                            <!-- Unidades -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="UNIDADES" Margin="0,10,0,3" />
                            <ComboBox x:Name="CmbUnits" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="OnUnitsChanged">
                                <ComboBoxItem Content="Milímetros (mm)" IsSelected="True" />
                                <ComboBoxItem Content="Pontos (pt)" />
                                <ComboBoxItem Content="Centímetros (cm)" />
                            </ComboBox>

                            <!-- Orientação -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="ORIENTAÇÃO" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BtnPortrait" Style="{StaticResource OrientToggle}"
                                             GroupName="Orientation" Checked="OnOrientationChanged" ToolTip="Retrato"
                                             Foreground="#9E9E9E">
                                    <Path Data="M 7,1 L 13,1 L 13,18 L 7,18 Z M 4,19.5 L 16,19.5"
                                          Stroke="#9E9E9E" StrokeThickness="1.3" Width="20" Height="22" Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </RadioButton>
                                <RadioButton x:Name="BtnLandscape" Style="{StaticResource OrientToggle}"
                                             GroupName="Orientation" Checked="OnOrientationChanged" ToolTip="Paisagem"
                                             Foreground="#9E9E9E">
                                    <Path Data="M 1,7 L 18,7 L 18,13 L 1,13 Z M -1,15.5 L 20,15.5"
                                          Stroke="#9E9E9E" StrokeThickness="1.3" Width="20" Height="22" Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </RadioButton>
                            </StackPanel>

                            <!-- Margem & Sangria -->
                            <Grid Margin="0,14,0,6">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="MARGEM &amp; SANGRIA" Margin="0"
                                           VerticalAlignment="Center" />
                                <ToggleButton x:Name="BtnLinkMargins" Style="{StaticResource LinkToggle}"
                                              IsChecked="True" ToolTip="Sincronizar as quatro margens"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="OnLinkMarginsChanged" Unchecked="OnLinkMarginsChanged">
                                    <Path x:Name="ChainIcon" Fill="#1473E6" Width="16" Height="16" Stretch="Uniform"
                                          Data="M 3.9,12 C 3.9,10.29 5.29,8.9 7,8.9 L 11,8.9 L 11,7 L 7,7 C 4.24,7 2,9.24 2,12 C 2,14.76 4.24,17 7,17 L 11,17 L 11,15.1 L 7,15.1 C 5.29,15.1 3.9,13.71 3.9,12 Z M 8,13 L 16,13 L 16,11 L 8,11 Z M 17,6 L 13,6 L 13,7.9 L 17,7.9 C 18.71,7.9 20.1,9.29 20.1,11 C 20.1,12.71 18.71,14.1 17,14.1 L 13,14.1 L 13,16 L 17,16 C 19.76,16 22,13.76 22,11 C 22,8.24 19.76,6 17,6 Z" />
                                </ToggleButton>
                            </Grid>
                            <UniformGrid Columns="4" HorizontalAlignment="Stretch">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SUPERIOR" />
                                    <TextBox x:Name="TxtMarginTop" Style="{StaticResource DarkTextBox}"
                                             TextChanged="OnMarginChanged" PreviewTextInput="OnNumberPreviewInput" />
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="INFERIOR" />
                                    <TextBox x:Name="TxtMarginBottom" Style="{StaticResource DarkTextBox}"
                                             TextChanged="OnMarginChanged" PreviewTextInput="OnNumberPreviewInput" />
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="ESQUERDA" />
                                    <TextBox x:Name="TxtMarginLeft" Style="{StaticResource DarkTextBox}"
                                             TextChanged="OnMarginChanged" PreviewTextInput="OnNumberPreviewInput" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="DIREITA" />
                                    <TextBox x:Name="TxtMarginRight" Style="{StaticResource DarkTextBox}"
                                             TextChanged="OnMarginChanged" PreviewTextInput="OnNumberPreviewInput" />
                                </StackPanel>
                            </UniformGrid>

                            <!-- Parâmetros de imposição -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="PARÂMETROS DE IMPOSIÇÃO" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="GAP ENTRE ETIQUETAS" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource StepperButton}" Content="−"
                                        Click="OnGapDecreaseClick" ToolTip="Diminuir gap" Margin="0,0,4,0" />
                                <TextBox Grid.Column="1" x:Name="TxtGap" Style="{StaticResource DarkTextBox}"
                                         TextChanged="OnGapChanged" PreviewTextInput="OnNumberPreviewInput"
                                         HorizontalContentAlignment="Center" />
                                <Button Grid.Column="2" Style="{StaticResource StepperButton}" Content="+"
                                        Click="OnGapIncreaseClick" ToolTip="Aumentar gap" Margin="4,0,0,0" />
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="TAMANHO DA ETIQUETA" Margin="0,10,0,3" />
                            <Border Background="{StaticResource AIInput}" BorderBrush="{StaticResource AIInputBorder}"
                                    BorderThickness="1" CornerRadius="3" Padding="8,5">
                                <TextBlock Text="90 × 35 mm  (orientação definida pela escolha acima)"
                                           FontSize="11.5" Foreground="#C9C9C9" />
                            </Border>

                            <!-- Opções avançadas -->
                            <Expander Style="{StaticResource AdvExpander}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MODOS DE CORES" />
                                    <ComboBox Style="{StaticResource DarkCombo}" IsEnabled="False" SelectedIndex="0">
                                        <ComboBoxItem Content="Preto Puro (DeviceGray · K:100%)" />
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="EFEITOS DE RASTERIZAÇÃO" Margin="0,10,0,3" />
                                    <ComboBox Style="{StaticResource DarkCombo}" IsEnabled="False" SelectedIndex="0">
                                        <ComboBoxItem Content="Alta (300 ppi)" />
                                    </ComboBox>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============ RODAPÉ ============ -->
            <Border Grid.Row="3" Background="{StaticResource AIBgLeft}"
                    BorderBrush="{StaticResource AIBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Fechar" Click="OnCloseClick" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Criar / Aplicar" Click="OnApplyClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>