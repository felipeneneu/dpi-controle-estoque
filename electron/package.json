{
  "name": "dpi-controle-estoque-electron",
  "version": "0.1.0",
  "private": true,
  "description": "App desktop (Electron) do Dpi Controle de Estoque — instaladores Server e Client.",
  "author": "Felipe Neneu Desenvolvedor",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "electron . --serve",
    "package": "electron-builder --win",
    "package:server": "electron-builder --win --config electron-builder.server.yml",
    "package:client": "electron-builder --win --config electron-builder.client.yml"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}